# ================================================================
# strapicms/.env.production  —  Hetzner VPS Production Variables
# Upload this file to /var/www/YAHAYASCHOOL/strapicms/.env
# on the server (Strapi reads from .env, not .env.production)
# ================================================================

# --- Strapi Secrets ---
# Regenerate each with: node -e "console.log(require('crypto').randomBytes(16).toString('base64'))"
APP_KEYS=REPLACE_ME_KEY1,REPLACE_ME_KEY2,REPLACE_ME_KEY3,REPLACE_ME_KEY4
API_TOKEN_SALT=REPLACE_ME
ADMIN_JWT_SECRET=REPLACE_ME
JWT_SECRET=REPLACE_ME
TRANSFER_TOKEN_SALT=REPLACE_ME
ENCRYPTION_KEY=REPLACE_ME

# --- Database (PostgreSQL on same VPS or external) ---
DATABASE_CLIENT=postgres
# Option A — If PostgreSQL is on the same Hetzner VPS (recommended):
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_NAME=yahaya_school
DATABASE_USERNAME=yahaya_user
DATABASE_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
DATABASE_SSL=false
DATABASE_SCHEMA=public

# Option B — External managed DB (Neon, Supabase, etc.):
# DATABASE_URL=postgresql://USER:PASS@HOST:5432/DBNAME
# DATABASE_SSL=true
# DATABASE_SSL_REJECT_UNAUTHORIZED=false

DATABASE_POOL_MIN=1
DATABASE_POOL_MAX=5

# --- Cloudinary — Persistent Image Storage ---
# Keep same credentials as before (images already uploaded there)
CLOUDINARY_NAME=db9wzb7z5
CLOUDINARY_KEY=833288718934649
CLOUDINARY_SECRET=eqntQn9Dk8eozNyCuwQWDybpu58
CLOUDINARY_FOLDER=yahaya-school

# --- Email ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your@gmail.com
SMTP_PASSWORD=your_app_password
EMAIL_FROM=noreply@yahayascool.edu.ng
EMAIL_REPLY_TO=support@yahayascool.edu.ng

# --- CORS — Frontend origin ---
FRONTEND_URL=https://hassanskdev.site

# --- Server ---
HOST=0.0.0.0
PORT=1339
NODE_ENV=production
STRAPI_TELEMETRY_DISABLED=true
