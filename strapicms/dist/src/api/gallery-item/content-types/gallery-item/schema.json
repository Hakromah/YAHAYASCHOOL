{
    "kind": "collectionType",
    "collectionName": "gallery_items",
    "info": {
        "singularName": "gallery-item",
        "pluralName": "gallery-items",
        "displayName": "4. Website - Gallery Item",
        "description": "Photo and video albums for school gallery"
    },
    "options": {
        "draftAndPublish": true
    },
    "pluginOptions": {
        "i18n": {
            "localized": true
        },
        "content-manager": {
            "visible": true
        }
    },
    "attributes": {
        "title": {
            "pluginOptions": {
                "i18n": {
                    "localized": true
                }
            },
            "type": "string",
            "required": true
        },
        "description": {
            "pluginOptions": {
                "i18n": {
                    "localized": true
                }
            },
            "type": "text"
        },
        "mediaType": {
            "type": "enumeration",
            "enum": [
                "photo",
                "video"
            ],
            "default": "photo"
        },
        "mediaFile": {
            "type": "media",
            "multiple": false,
            "required": false,
            "allowedTypes": [
                "images",
                "videos"
            ]
        },
        "category": {
            "pluginOptions": {
                "i18n": {
                    "localized": true
                }
            },
            "type": "string",
            "default": "Campus"
        },
        "isFeatured": {
            "type": "boolean",
            "default": false
        }
    }
}
