            "type": "string",
            "required": true
        },
        "description": {
            "type": "text"
        },
        "dateEarned": {
            "type": "date",
            "required": true
        },
        "student": {
            "type": "relation",
            "relation": "manyToOne",
            "target": "api::student.student"
        }
    }
}
