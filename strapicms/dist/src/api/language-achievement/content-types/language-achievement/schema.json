{
    "kind": "collectionType",
    "collectionName": "language_achievements",
    "info": {
        "singularName": "language-achievement",
        "pluralName": "language-achievements",
        "displayName": "Language Achievement",
        "description": "Schema for Language Achievement"
    },
    "options": {
        "draftAndPublish": false
    },
    "pluginOptions": {
