{
  "kind": "singleType",
  "collectionName": "school_profiles",
  "info": {
    "singularName": "school-profile",
    "pluralName": "school-profiles",
    "displayName": "1. School Profile & Settings",
    "description": "Global school settings, branding, and configuration"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {
    "content-manager": {
      "visible": true
    }
  },
  "attributes": {
    "schoolName": {
      "type": "string",
      "required": true,
      "maxLength": 200,
      "default": "Yahaya International Islamic and English High School"
    },
    "motto": {
      "type": "text"
    },
    "address": {
      "type": "text"
    },
    "phone": {
      "type": "string",
      "maxLength": 30
    },
    "email": {
      "type": "email"
    },
    "website": {
      "type": "string",
      "maxLength": 200
    },
    "logo": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "images"
      ]
    },
    "academicYearStart": {
      "type": "date"
    },
    "academicYearEnd": {
      "type": "date"
    },
    "timezone": {
      "type": "string",
      "default": "Africa/Lagos",
      "maxLength": 100
    },
    "defaultLanguage": {
      "type": "enumeration",
      "enum": [
        "en",
        "ar",
        "fr",
        "tr"
      ],
      "default": "en"
    },
    "socialLinks": {
      "type": "component",
      "repeatable": true,
      "component": "contact.social-media"
    },
    "registrationNumber": {
      "type": "string",
      "maxLength": 100
    },
    "foundedYear": {
      "type": "integer",
      "min": 1900,
      "max": 2100
    }
  }
}
