{
  "kind": "collectionType",
  "collectionName": "academic_terms",
  "info": {
    "singularName": "academic-term",
    "pluralName": "academic-terms",
    "displayName": "2. Academic - Academic Term",
    "description": "Specific terms within an academic year (e.g., First Term)"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {
    "content-manager": {
      "visible": true
    }
  },
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "startDate": {
      "type": "date",
      "required": true
    },
    "endDate": {
      "type": "date",
      "required": true
    },
    "academicYear": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::academic-year.academic-year",
      "inversedBy": "terms"
    },
    "active": {
      "type": "boolean",
      "default": true
    }
  }
}
