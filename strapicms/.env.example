# ─────────────────────────────────────────────────────────────────────────────
# strapicms/.env.example
# Copy to .env for local dev. For Strapi Cloud, paste these into
# Project → Settings → Variables (NOT DATABASE_URL — Cloud manages that).
# NEVER commit .env to git.
# ─────────────────────────────────────────────────────────────────────────────

# ── Secrets ────────────────────────────────────────────────────────────────
# Generate each with: node -e "console.log(require('crypto').randomBytes(16).toString('base64'))"
APP_KEYS=key1,key2,key3,key4
API_TOKEN_SALT=REPLACE_ME
ADMIN_JWT_SECRET=REPLACE_ME
JWT_SECRET=REPLACE_ME
TRANSFER_TOKEN_SALT=REPLACE_ME
ENCRYPTION_KEY=REPLACE_ME

# ── Database — LOCAL DEV ONLY ──────────────────────────────────────────────
# Strapi Cloud auto-configures the database. Only set these for local dev.
DATABASE_CLIENT=postgres
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_NAME=yahaya_scool
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres
DATABASE_SSL=false
DATABASE_SCHEMA=public
DATABASE_POOL_MIN=1
DATABASE_POOL_MAX=5

# ── Cloudinary — Image/File Storage ───────────────────────────────────────
# Required in production to persist uploaded images across deploys.
# Get credentials at: https://cloudinary.com/console
CLOUDINARY_NAME=your_cloud_name
CLOUDINARY_KEY=your_api_key
CLOUDINARY_SECRET=your_api_secret
CLOUDINARY_FOLDER=yahaya-school

# ── Email ─────────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your@gmail.com
SMTP_PASSWORD=your_app_password
EMAIL_FROM=noreply@yahayascool.edu.ng
EMAIL_REPLY_TO=support@yahayascool.edu.ng

# ── Frontend CORS ─────────────────────────────────────────────────────────
FRONTEND_URL=https://yahayaschool.vercel.app

# ── Misc ──────────────────────────────────────────────────────────────────
STRAPI_TELEMETRY_DISABLED=true
