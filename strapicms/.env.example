# ─────────────────────────────────────────────────────────────────────────────
# strapicms/.env.example
# Copy to .env for local dev. For Render, paste these into
# Web Service → Environment tab.
# NEVER commit .env to git.
# ─────────────────────────────────────────────────────────────────────────────

# ── Secrets ────────────────────────────────────────────────────────────────
# Generate each with: node -e "console.log(require('crypto').randomBytes(16).toString('base64'))"
APP_KEYS=key1,key2,key3,key4
API_TOKEN_SALT=REPLACE_ME
ADMIN_JWT_SECRET=REPLACE_ME
JWT_SECRET=REPLACE_ME
TRANSFER_TOKEN_SALT=REPLACE_ME
ENCRYPTION_KEY=REPLACE_ME

# ── Database ───────────────────────────────────────────────────────────────
DATABASE_CLIENT=postgres

# Render provides a single connection string — use this on Render:
DATABASE_URL=postgresql://USER:PASS@HOST:5432/DBNAME
DATABASE_SSL=true
DATABASE_SSL_REJECT_UNAUTHORIZED=false

# Local dev only (comment out DATABASE_URL above, uncomment these):
# DATABASE_HOST=127.0.0.1
# DATABASE_PORT=5432
# DATABASE_NAME=yahaya_scool
# DATABASE_USERNAME=postgres
# DATABASE_PASSWORD=postgres
# DATABASE_SSL=false
# DATABASE_SCHEMA=public

DATABASE_POOL_MIN=1
DATABASE_POOL_MAX=5

# ── Cloudinary — Image/File Storage ───────────────────────────────────────
# Required: Render filesystem resets on every redeploy — images would be lost.
# Get credentials at: https://cloudinary.com/console
CLOUDINARY_NAME=your_cloud_name
CLOUDINARY_KEY=your_api_key
CLOUDINARY_SECRET=your_api_secret
CLOUDINARY_FOLDER=yahaya-school

# ── Email ─────────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your@gmail.com
SMTP_PASSWORD=your_app_password
EMAIL_FROM=noreply@yahayascool.edu.ng
EMAIL_REPLY_TO=support@yahayascool.edu.ng

# ── Frontend CORS ─────────────────────────────────────────────────────────
FRONTEND_URL=https://yahayaschool.vercel.app

# ── Server ────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=1339
NODE_ENV=production
STRAPI_TELEMETRY_DISABLED=true
